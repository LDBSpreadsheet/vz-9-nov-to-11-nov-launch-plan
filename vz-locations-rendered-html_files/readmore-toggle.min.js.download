document.addEventListener("DOMContentLoaded",function(){document.querySelectorAll(".text-toggle").forEach(function(e){var t=e.closest(".text-expandable");if(t){var d=t.querySelector(".expanded-content"),s=e.querySelector(".toggle-text-open"),n=e.querySelector(".toggle-text-close"),o=e.querySelector(".toggle-icon");d&&s&&n&&o&&e.addEventListener("click",function(e){e.preventDefault(),d.classList.contains("hidden")?(d.classList.remove("hidden"),d.style.display="block",s.classList.add("hidden"),n.classList.remove("hidden"),o.style.transform="rotate(180deg)"):(d.classList.add("hidden"),d.style.display="none",s.classList.remove("hidden"),n.classList.add("hidden"),o.style.transform="rotate(0deg)")})}})});