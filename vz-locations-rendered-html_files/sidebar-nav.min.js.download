document.addEventListener("DOMContentLoaded",function(){document.querySelectorAll(".toggle-item").forEach(function(t){t.addEventListener("click",function(t){if(!t.target.closest("a")){t.preventDefault(),t.stopPropagation();var e=this.getAttribute("data-target"),n=document.getElementById(e),o=this.querySelector(".arrow-icon");n&&(n.classList.contains("hidden")?(n.classList.remove("hidden"),o.style.transform="rotate(180deg)"):(n.classList.add("hidden"),o.style.transform="rotate(0deg)"))}})})});